class Refused(Exception):
    def __init__(self, code=4):
        self.code = code
        super().__init__(ERRORS[code])


def require(condition, reason=None, code=4):
    """Reason is internal provenance, never leaked into public diagnostics."""
    if not condition:
        raise Refused(code)


def H(data):
    return hashlib.sha256(data).hexdigest()


def C(value):
    return (
        json.dumps(value, sort_keys=True, indent=2, ensure_ascii=True, allow_nan=False) + "\n"
    ).encode()


def pairs(items):
    result = {}
    for key, value in items:
        require(key not in result)
        result[key] = value
    return result


def bounds(value, depth=0):
    require(depth <= 12)
    if type(value) is dict:
        require(len(value) <= 1024)
        for key, item in value.items():
            bounds(key, depth + 1)
            bounds(item, depth + 1)
    elif type(value) is list:
        require(len(value) <= 1024)
        for item in value:
            bounds(item, depth + 1)
    elif type(value) is str:
        require("\x00" not in value and len(value.encode("utf-8")) <= 65536)
    else:
        require(value is None or type(value) in (bool, int))


def decode(raw, limit=262144):
    require(0 < len(raw) <= limit)
    try:
        value = json.loads(raw.decode("utf-8"), object_pairs_hook=pairs)
        bounds(value)
        require(C(value) == raw)
        return value
    except (ValueError, UnicodeError, RecursionError) as exc:
        raise Refused() from exc


def validate(value, schema):
    """Finite frozen schema vocabulary; no remote references or includes."""
    if "oneOf" in schema:
        matches = 0
        for branch in schema["oneOf"]:
            try:
                validate(value, branch)
                matches += 1
            except Refused:
                pass
        require(matches == 1)
        return
    types = {
        "object": dict,
        "array": list,
        "string": str,
        "integer": int,
        "boolean": bool,
        "null": type(None),
    }
    if "type" in schema:
        require(type(value) is types[schema["type"]])
    if "const" in schema:
        require(type(value) is type(schema["const"]) and value == schema["const"])
    if "enum" in schema:
        require(any(type(value) is type(item) and value == item for item in schema["enum"]))
    if type(value) is dict:
        properties = schema.get("properties", {})
        require(set(schema.get("required", ())) <= set(value))
        if schema.get("additionalProperties") is False:
            require(set(value) <= set(properties))
        for key, item in value.items():
            if key in properties:
                validate(item, properties[key])
    elif type(value) is list:
        require(schema.get("minItems", 0) <= len(value) <= schema.get("maxItems", 1024))
        if schema.get("uniqueItems"):
            require(len({C(item) for item in value}) == len(value))
        prefixes = schema.get("prefixItems", [])
        for index, item in enumerate(value):
            branch = prefixes[index] if index < len(prefixes) else schema.get("items", {})
            require(branch is not False)
            if branch is not True:
                validate(item, branch)
    elif type(value) is str:
        require(schema.get("minLength", 0) <= len(value) <= schema.get("maxLength", 65536))
        if "pattern" in schema:
            require(re.search(schema["pattern"], value) is not None)
    elif type(value) is int:
        require(schema.get("minimum", value) <= value <= schema.get("maximum", value))


def keys(value, expected):
    require(type(value) is dict and set(value) == set(expected.split()))


def version(value, name, number):
    require(
        value["schema"] == name
        and type(value["schema_version"]) is int
        and value["schema_version"] == number
    )


def safe(name):
    require(
        type(name) is str
        and 0 < len(name) <= 4096
        and not name.startswith("/")
        and "\\" not in name
        and not any(ord(c) < 32 or ord(c) == 127 for c in name)
        and all(p not in ("", ".", "..") for p in name.split("/"))
    )


def text(value):
    require(
        type(value) is str
        and 0 < len(value.encode()) <= 65536
        and "\x00" not in value
        and "{{" not in value
    )


def digest(value):
    require(type(value) is str and re.fullmatch("[0-9a-f]{64}", value) is not None)


def identity(info):
    if stat.S_ISDIR(info.st_mode):
        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid)
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_nlink,
        info.st_uid,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


class Held:
    """Walk from / using dirfds; reject links, races and special files.

    Open descriptors remain held until final identity checks. O_NONBLOCK avoids
    waiting on hostile FIFOs; identity checks include name replacement and edits.
    """

    def __init__(self):
        self.handles = []

    def open(self, absolute, directory=False, mode=None, limit=262144, runtime=False):
        path = Path(absolute)
        require(path.is_absolute() and str(path) == str(absolute) and str(path) != "/")
        safe(str(path)[1:])
        fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
        try:
            for index, component in enumerate(path.parts[1:]):
                last = index == len(path.parts) - 2
                flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                if not last or directory:
                    flags |= os.O_DIRECTORY
                child = os.open(component, flags, dir_fd=fd)
                info = os.fstat(child)
                self.handles.append((child, fd, component, identity(info)))
                if not last or directory:
                    require(stat.S_ISDIR(info.st_mode))
                else:
                    require(
                        stat.S_ISREG(info.st_mode)
                        and (
                            info.st_nlink == 1
                            or (
                                runtime
                                and str(path)
                                in {r["path"] for r in RUNTIME["runtime_shared_libraries"]}
                            )
                        )
                        and info.st_size <= limit
                    )
                fd = child
            info = os.fstat(fd)
            if mode is not None:
                require(stat.S_IMODE(info.st_mode) == mode and info.st_uid == os.getuid())
            return fd
        except BaseException:
            if not self.handles:
                os.close(fd)
            raise

    def read(self, path, mode=None, limit=262144, runtime=False):
        fd = self.open(path, mode=mode, limit=limit, runtime=runtime)
        raw = bytearray()
        while True:
            piece = os.read(fd, min(65536, limit + 1 - len(raw)))
            if not piece:
                break
            raw.extend(piece)
            require(len(raw) <= limit)
        self.check()
        return bytes(raw)

    def check(self):
        for fd, parent, name, original in self.handles:
            require(identity(os.fstat(fd)) == original)
            require(identity(os.stat(name, dir_fd=parent, follow_symlinks=False)) == original)

    def close(self):
        descriptors = {fd for fd, _, _, _ in self.handles}
        descriptors.update(parent for _, parent, _, _ in self.handles)
        for fd in descriptors:
            os.close(fd)
        self.handles.clear()

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()


def read(snapshot, name):
    safe(name)
    require(name in snapshot)
    return snapshot[name]


def load(snapshot, name):
    raw = read(snapshot, name)
    value = decode(raw)
    schema = INPUT_SCHEMAS.get(name)
    if schema:
        validate(value, SCHEMAS[schema])
    return value, raw


