-tooling/SKILL.md",\n    "t3-campaign/SKILL.md",\n    "t3-campaign/references/executor-briefs.md",\n    "t3-task/SKILL.md",\n    "t3-wait/SKILL.md"\n  ],\n  "source_count": 26,\n  "source_paths": [\n    "internal/toolproducer/testdata/descriptors/fixture-cli.json",\n    "internal/toolproducer/testdata/descriptors/fixture-mcp.json",\n    "internal/toolproducer/testdata/descriptors/fixture-third-party.json",\n    "shared/agent-instructions/config/bin/agents-instructions-gen",\n    "shared/agent-instructions/config/bin/agents-role-project",\n    "shared/agent-instructions/config/claude/CLAUDE.md",\n    "shared/agent-instructions/config/claude/skills/huyang/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/implementation-session/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/implementation-session/references/prompt-template.md",\n    "shared/agent-instructions/config/claude/skills/ov-memory-curation/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/ov-memory/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/publish-agent-tooling/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/t3-campaign/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/t3-campaign/references/executor-briefs.md",\n    "shared/agent-instructions/config/claude/skills/t3-task/SKILL.md",\n    "shared/agent-instructions/config/claude/skills/t3-wait/SKILL.md",\n    "shared/agent-instructions/owner.json",\n    "shared/catalog-guidance/config/bin/agents-tool-project",\n    "shared/catalog-guidance/guidance/fixture-cli.json",\n    "shared/catalog-guidance/guidance/fixture-mcp.json",\n    "shared/catalog-guidance/guidance/fixture-third-party.json",\n    "shared/catalog-guidance/guidance/huyang.json",\n    "shared/catalog-guidance/guidance/manifest.json",\n    "shared/catalog-guidance/guidance/required-global-policy.json",\n    "shared/catalog-guidance/owner.json",\n    "shared/catalog-guidance/templates/discovery.txt"\n  ]\n}\n'
)


def _project(root):
    cat, cb = load(root, "inputs/tool-catalog.json")
    pr, pb = load(root, "inputs/tool-producer-receipt.json")
    models, mb = load(root, "inputs/model-blocks.json")
    manifest, gb = load(root, "guidance/manifest.json")
    keys(
        manifest,
        "schema schema_version catalog_sha256 producer_receipt_sha256 policy_sha256 required_global_policy records",
    )
    version(manifest, "tool-guidance-manifest/v1", 1)
    require(
        H(cb) == manifest["catalog_sha256"] and H(pb) == manifest["producer_receipt_sha256"],
        "catalog-receipt-pin",
    )
    require(
        pr["catalog_sha256"] == H(cb)
        and pr["input_sha256"] == H(read(root, "inputs/tool-producer-input.json"))
        and (manifest["policy_sha256"] == H(read(root, "inputs/route-policy.json"))),
        "stage-a-policy-input-crosspins",
    )
    tools = {t["id"]: t for t in cat["tools"]}
    require(len(tools) == len(cat["tools"]) == 4, "catalog-ids")
    require([r["tool_id"] for r in manifest["records"]] == sorted(tools), "guidance-ids")
    required = manifest["required_global_policy"]
    keys(required, "path sha256")
    require(required["path"] == "guidance/required-global-policy.json")
    policy, polb = load(root, required["path"])
    require(H(polb) == required["sha256"], "global-pin")
    keys(policy, "schema schema_version provenance texts operational_reference deferred_owner_seam")
    version(policy, "required-global-policy/v1", 1)
    keys(policy["texts"], "shared claude")
    keys(
        policy["provenance"],
        "source_path source_sha256 claude_source_path claude_source_sha256 baseline_main_sha256 prior_template_sha256 reference_sha256",
    )
    seam = policy["deferred_owner_seam"]
    keys(
        seam,
        "schema tool_id catalog_membership status required_rules resident_quotes current_bound_owner required_interface handoff",
    )
    require(
        seam["schema"] == "required-owner-handoff/v1"
        and seam["tool_id"] == "t3-steward"
        and (seam["catalog_membership"] == "absent")
        and (seam["status"] == "blocked-owner-handoff")
        and ("t3-steward" not in tools),
        "deferred-owner-seam",
    )
    require(
        all(
            q in policy["texts"]["shared"] and q in policy["texts"]["claude"]
            for q in seam["resident_quotes"]
        ),
        "required-seam-residency",
    )
    layout, lb = load(root, "templates/discovery.txt")
    keys(layout, "schema_version bindings texts")
    require(
        type(layout["schema_version"]) is int and layout["schema_version"] == 4, "layout-version"
    )
    bind = layout["bindings"]
    keys(
        bind,
        "import_repository import_commit import_tree imported_owner_sha256 imported_source_sha256 baseline_main_sha256 policy_sha256 model_block_sha256 operational_reference_sha256 guidance_manifest_sha256 required_global_policy_sha256",
    )
    require(
        H(gb) == bind["guidance_manifest_sha256"]
        and H(polb) == bind["required_global_policy_sha256"]
        and (bind["policy_sha256"] == manifest["policy_sha256"]),
        "layout-crosspins",
    )
    require(
        bind["import_commit"] == "b32c0b6f48e12b7d74a60f8a010f84bab73d299f"
        and bind["import_tree"] == "fc0e7ad2bad7a7df96030f71696125b5a7d5bd52",
        "import-tuple",
    )
    require(
        H(policy["operational_reference"].encode())
        == bind["operational_reference_sha256"]
        == policy["provenance"]["reference_sha256"],
        "reference-pin",
    )
    for p, h in bind["baseline_main_sha256"].items():
        require(H(read(root, "baseline/" + p)) == h, "baseline-pin")
    require(set(models) == set(bind["baseline_main_sha256"]), "models-paths")
    for p, b in models.items():
        require(read(root, "baseline/" + p).count(b.encode()) == 1, "model-baseline")
        require(
            H(b.encode()) == bind["model_block_sha256"]["claude" if ".claude/" in p else "codex"],
            "model-pin",
        )
    profile, profbytes = load(root, "inputs/guidance-profile.json")
    keys(profile, "schema schema_version scope snapshot_id evidence tools")
    version(profile, "guidance-profile/v1", 1)
    require(profile["scope"] == "fixture-only", "profile-runtime-claim")
    keys(profile["evidence"], "path sha256")
    require(
        profile["evidence"]["path"] == "inputs/guidance-observation.json"
        and H(read(root, profile["evidence"]["path"])) == profile["evidence"]["sha256"],
        "availability-evidence",
    )
    observation, ob = load(root, profile["evidence"]["path"])
    keys(
        observation, "schema schema_version source_commit source_tree source_reads descriptor_reads"
    )
    version(observation, "guidance-observation/v1", 1)
    require(
        observation["source_commit"] == "0ff4f4c6882294a59992baf2fed6607ff2467c50"
        and observation["source_tree"] == "bd26c0446428e4268e0895c8918f5aeacde8639e",
        "observed-source-pin",
    )
    owner_hashes = {
        f["path"]: H(f["content"].encode())
        for f in observation["source_reads"]["data"]["files"]
        + observation["descriptor_reads"]["data"]["files"]
    }
    require(len(owner_hashes) == 17, "owner-evidence-closure")
    require([x["tool_id"] for x in profile["tools"]] == sorted(tools), "profile-ids")
    ps = {}
    for x in profile["tools"]:
        keys(x, "tool_id availability visibility authorized enforced")
        require(
            x["availability"] in ["observed", "unavailable", "unknown"]
            and x["visibility"] in ["visible", "hidden"]
            and (x["authorized"] in ["unknown", "denied", "declaration-only"])
            and (x["enforced"] == "unqualified"),
            "profile-grant",
        )
        ps[x["tool_id"]] = x
    outputs = {}
    rows = []
    menus = []
    fragments = []
    bindings = []
    blockers = []
    for rec in manifest["records"]:
        keys(rec, "tool_id path sha256")
        id = rec["tool_id"]
        require(rec["path"] == "guidance/" + id + ".json", "guidance-path")
        g, b = load(root, rec["path"])
        require(H(b) == rec["sha256"], "guidance-pin")
        keys(g, "schema schema_version tool_id owner purpose rules help capability_ids workflow")
        version(g, "tool-guidance/v1", 1)
        require(g["tool_id"] == id, "guidance-tool-id")
        text(g["purpose"])
        require(g["capability_ids"] == tools[id]["capabilities"], "capability-ids")
        owner = g["owner"]
        keys(
            owner, "kind owning_path evidence_path evidence_sha256 source_path source_sha256 status"
        )
        require(
            owner["kind"] in ["imported-guidance-proposal", "catalog-fixture"]
            and owner["owning_path"] == "shared/catalog-guidance/" + rec["path"]
            and (owner["status"] == "hypothetical-new-owner-input-unapproved"),
            "owner-provenance",
        )
        digest(owner["source_sha256"])
        safe(owner["source_path"])
        require(H(read(root, owner["evidence_path"])) == owner["evidence_sha256"], "owner-evidence")
        require(
            owner["source_path"] in owner_hashes
            and owner["source_sha256"] == owner_hashes[owner["source_path"]],
            "owner-source-pin",
        )
        if id == "huyang":
            require(
                owner["source_sha256"]
                == bind["imported_source_sha256"]["config/claude/skills/huyang/SKILL.md"],
                "imported-guidance-source-pin",
            )
        ruleids = []
        for r in g["rules"]:
            keys(r, "id text placement evidence_quote_sha256")
            require(
                re.fullmatch(id + "\\.[a-z-]+\\.v1", r["id"]) and r["id"] not in ruleids, "rule-id"
            )
            ruleids.append(r["id"])
            require(r["placement"] == "before-tool-choice", "rule-placement")
            text(r["text"])
            digest(r["evidence_quote_sha256"])
        require(ruleids == (["huyang.repository-boundary.v1"] if id == "huyang" else []))
        for s in g["workflow"]:
            text(s)
        help = g["help"]
        kind = help["kind"]
        if kind == "pinned-reference":
            keys(help, "kind path sha256 display_path")
            require(
                help["path"] == ".config/agents/huyang.md"
                and help["display_path"] == "~/.config/agents/huyang.md",
                "help-route",
            )
            detail = read(root, "final-instructions/" + help["path"])
            require(H(detail) == help["sha256"], "help-pin")
            route = "help reference: " + help["display_path"]
        elif kind == "catalog-record":
            keys(help, "kind path sha256 tool_id")
            require(
                help["path"] == "inputs/tool-catalog.json"
                and help["sha256"] == H(cb)
                and (help["tool_id"] == id),
                "catalog-help",
            )
            detail = C(tools[id])
            route = "reference: inputs/tool-catalog.json entry " + id + " (no executable help)"
        else:
            raise Refused()
        p = ps[id]
        active = p["availability"] == "observed" and p["visibility"] == "visible"
        blocked = tools[id]["required"] and (not active)
        if blocked:
            blockers.append(id)
        decision = (
            "required-interface-blocked"
            if blocked
            else "visible-observed"
            if active
            else "hidden"
            if p["visibility"] == "hidden"
            else "declaration-only"
            if p["availability"] == "unknown"
            else "unavailable"
        )
        ruletext = "\n\n".join(r["text"] for r in g["rules"])
        frag = (
            id
            + ": "
            + g["purpose"]
            + "; "
            + route
            + ".\n\n"
            + (ruletext + "\n\n" if ruletext else "")
            if active
            else "Required interface "
            + id
            + " is "
            + p["availability"]
            + "/"
            + p["visibility"]
            + "; stop dependent work; no fallback or access grant.\n\n"
            if blocked
            else ""
        )
        outputs["fragments/" + id + ".md"] = frag.encode()
        fragments.append(frag)
        rows.append("- " + id + ": " + g["purpose"] + "; " + decision + "; " + route + ".")
        menu = {
            "tool_id": id,
            "catalog_record": tools[id],
            "owner": owner,
            "guidance_sha256": H(b),
            "purpose": g["purpose"],
            "rules": g["rules"],
            "workflow": g["workflow"],
            "help": help,
            "detail": detail.decode(),
            "availability": p["availability"],
            "visibility": p["visibility"],
            "authorized": p["authorized"],
            "enforced": p["enforced"],
            "decision": decision,
            "fragment_sha256": H(frag.encode()),
        }
        menus.append(menu)
        bindings.append(
            {
                "tool_id": id,
                "guidance_sha256": H(b),
                "source_owner": owner,
                "rule_ids": ruleids,
                "fragment_sha256": H(frag.encode()),
                "help_sha256": H(detail),
                "decision": decision,
            }
        )
    menu = {
        "schema": "guidance-menu/v1",
        "schema_version": 1,
        "state": "candidate-inert",
        "profile_scope": "fixture-only",
        "catalog_sha256": H(cb),
        "guidance_manifest_sha256": H(gb),
        "profile_sha256": H(profbytes),
        "status": "required-interface-blocked" if blockers else "fixture-projection-only",
        "blockers": blockers,
        "tools": menus,
    }
    outputs["menu.json"] = C(menu)
    outputs["menu.txt"] = (
        "Candidate fixture menu: "
        + menu["status"]
        + "\nAvailability/visibility/authorization/enforcement are distinct; no runtime grants.\n\n"
        + "\n\n".join(
            "Tool "
            + m["tool_id"]
            + "\n"
            + next(r for r in rows if r.startswith("- " + m["tool_id"] + ":"))
            + "\nCapabilities: "
            + ", ".join(m["catalog_record"]["capabilities"])
            + "\nRequired: "
            + str(m["catalog_record"]["required"]).lower()
            + "; authorized: "
            + m["authorized"]
            + "; enforced: "
            + m["enforced"]
            + "\n"
            + "\n".join(r["text"] for r in m["rules"])
            + "\n"
            + "\n".join(m["workflow"])
            + "\nOn-demand help:\n"
            + m["detail"]
            for m in menus
        )
        + "\n"
    ).encode()
    texts = layout["texts"]
    keys(texts, "shared claude codex discovery")
    expected = {
        "shared": ["GLOBAL_SHARED", "FRAGMENTS", "MODEL_CODEX", "DISCOVERY"],
        "claude": ["GLOBAL_CLAUDE", "FRAGMENTS", "MODEL_CLAUDE", "DISCOVERY"],
        "codex": ["SHARED_MAIN"],
        "discovery": ["MENU_ROWS", "CATALOG_SHA256", "PRODUCER_RECEIPT_SHA256"],
    }
    for k, v in texts.items():
        require(
            sorted(re.findall("\\{\\{([A-Z][A-Z0-9_]*)\\}\\}", v)) == sorted(expected[k])
            and all(v.count("{{" + x + "}}") == 1 for x in expected[k]),
            "layout-tokens",
        )
        require(not re.sub("\\{\\{[A-Z][A-Z0-9_]*\\}\\}", "", v).count("{{"), "layout-marker")
    require(
        texts["shared"] == "{{GLOBAL_SHARED}}{{FRAGMENTS}}{{MODEL_CODEX}}\n\n{{DISCOVERY}}"
        and texts["claude"] == "{{GLOBAL_CLAUDE}}{{FRAGMENTS}}{{MODEL_CLAUDE}}\n\n{{DISCOVERY}}"
        and (texts["codex"] == "<!-- fleet:start -->\n{{SHARED_MAIN}}<!-- fleet:end -->\n")
        and (
            texts["discovery"]
            == "## Candidate tool discovery\n\n{{MENU_ROWS}}\nCatalog SHA256: {{CATALOG_SHA256}}\nProducer receipt SHA256: {{PRODUCER_RECEIPT_SHA256}}\n"
        ),
        "layout-behavior-duplication",
    )

    def expand(s, values):
        result = re.sub("\\{\\{([A-Z][A-Z0-9_]*)\\}\\}", lambda m: values[m[1]], s)
        require("{{" not in result and "\x00" not in result, "expansion")
        return result

    audit = (
        "Fixture snapshot only; unknown availability is declaration-only. Authorized unknown; enforcement unqualified. Required unknown/hidden/unavailable interfaces block dependent work; no silent fallback.\n"
        + "\n".join(rows)
    )
    discovery = expand(
        texts["discovery"],
        dict(MENU_ROWS=audit, CATALOG_SHA256=H(cb), PRODUCER_RECEIPT_SHA256=H(pb)),
    )
    outputs["discovery.txt"] = discovery.encode()
    values = {
        "GLOBAL_SHARED": policy["texts"]["shared"],
        "GLOBAL_CLAUDE": policy["texts"]["claude"],
        "FRAGMENTS": "".join(fragments),
        "MODEL_CODEX": models[".config/agents/AGENTS.md"],
        "MODEL_CLAUDE": models[".claude/omarchy-setup/CLAUDE.md"],
        "DISCOVERY": discovery,
    }
    shared = expand(texts["shared"], values)
    claude = expand(texts["claude"], values)
    codex = expand(texts["codex"], {"SHARED_MAIN": shared})
    for p, b in [
        (".config/agents/AGENTS.md", shared),
        (".claude/omarchy-setup/CLAUDE.md", claude),
        (".codex/AGENTS.md", codex),
        (".config/agents/operational-guidance.md", policy["operational_reference"]),
    ]:
        outputs["final-instructions/" + p] = b.encode()
    summary = {
        "schema": "dual-guidance-summary/v1",
        "schema_version": 1,
        "catalog_sha256": H(cb),
        "producer_receipt_sha256": H(pb),
        "guidance_manifest_sha256": H(gb),
        "required_global_policy_sha256": H(polb),
        "layout_sha256": H(lb),
        "profile_sha256": H(profbytes),
        "policy_sha256": bind["policy_sha256"],
        "status": menu["status"],
        "owner_handoff": seam["status"],
        "decisions": bindings,
        "files": [
            {"path": p, "bytes": len(b), "sha256": H(b), "mode": 420}
            for p, b in sorted(outputs.items())
        ],
    }
    return (outputs, summary)


def _complete_projection(snapshot):
    """Internal seam: return the exact 25 outputs, never a prepare result."""
    outputs, guidance = _project(snapshot)
    complete = {}
    for name in CLOSURE["instruction_paths"]:
        key = "final-instructions/" + name
        complete[name] = outputs.get(
            key,
            read(snapshot, "baseline/" + name)
            if name != ".config/agents/operational-guidance.md"
            else b"",
        )
    for name in CLOSURE["new_metadata_paths"]:
        complete[name] = outputs[name.removeprefix("metadata/guidance/")]
    require(len(complete) == 25)
    return complete, guidance, outputs["discovery.txt"]


def _snapshot(held, fixture_root, owning_root=None):
    """Acquire only closed fixture inputs; owning bytes override archived drafts."""
    root = Path(fixture_root)
    result = {}
    names = set(INPUT_SCHEMAS) | {"inputs/model-blocks.json", "inputs/route-policy.json"}
    names |= {
        "baseline/" + p
        for p in CLOSURE["instruction_paths"]
        if p != ".config/agents/operational-guidance.md"
    }
    names.add("final-instructions/.config/agents/huyang.md")
    for name in sorted(names):
        base = (
            Path(owning_root)
            if owning_root and name.startswith(("guidance/", "templates/"))
            else root
        )
        result[name] = held.read(base / name, mode=0o600 if name.startswith("inputs/") else 0o644)
    return result


def _source(held):
    repository = Path(__file__).absolute().parents[4]
    owning = repository / "shared/catalog-guidance"
    owner_raw = held.read(owning / "owner.json", mode=0o644)
    owner = decode(owner_raw)
    validate(owner, SCHEMAS["overlay_owner_v5"])
    pins = {}
    for name in CLOSURE["source_paths"]:
        mode = (
            0o755
            if name.endswith(
                ("agents-tool-project", "agents-role-project", "agents-instructions-gen")
            )
            else 0o644
        )
        pins[name] = H(held.read(repository / name, mode=mode, limit=1048576))
    require(
        H(held.read(Path(__file__).absolute(), mode=0o755, limit=1048576))
        == pins["shared/catalog-guidance/config/bin/agents-tool-project"]
    )
    require(all(pins[name] == pin for name, pin in SOURCE_PINS.items()))
    layout = decode(held.read(owning / "templates/discovery.txt", mode=0o644))
    binding = layout["bindings"]
    require(pins["shared/agent-instructions/owner.json"] == binding["imported_owner_sha256"])
    for name, pin in binding["imported_source_sha256"].items():
        require(pins["shared/agent-instructions/" + name] == pin)
    for tool in TOOLS:
        package = decode(held.read(owning / ("guidance/" + tool + ".json"), mode=0o644))
        require(pins[package["owner"]["source_path"]] == package["owner"]["source_sha256"])
    return repository, owning, pins


RUNTIME = json.loads(
