)


def _runtime():
    """Pin the public launch to the reviewed runtime; never re-exec via PATH."""
    try:
        require(sys.flags.isolated and sys.flags.no_site and sys.dont_write_bytecode, code=5)
        require(
            str(Path(sys.executable).absolute()) == RUNTIME["base_path"]
            and sys.version == RUNTIME["version"],
            code=5,
        )
        with Held() as held:
            data = held.read(RUNTIME["base_path"], limit=16777216)
            require(len(data) == RUNTIME["bytes"] and H(data) == RUNTIME["sha256"], code=5)
            for record in RUNTIME["runtime_shared_libraries"]:
                data = held.read(record["path"], limit=33554432, runtime=True)
                require(len(data) == record["bytes"] and H(data) == record["sha256"], code=5)
            held.check()
    except (Refused, OSError) as exc:
        raise Refused(5) from exc


def _prepare(args):
    request_path, request_pin, output_path = args
    digest(request_pin)
    with Held() as held:
        try:
            raw = held.read(request_path, mode=0o600)
            require(H(raw) == request_pin, code=3)
            request = decode(raw)
            validate(request, SCHEMAS["overlay_request_v4"])
        except (Refused, OSError, ValueError) as exc:
            raise Refused(3) from exc
        repository, owning, source_pins = _source(held)
        try:
            output_fd = held.open(output_path, directory=True, mode=0o700)
            require(not os.listdir(output_fd), code=7)
            out = Path(output_path)
            inputs = [Path(request_path), repository]
            inputs += [
                Path(value)
                for key, value in request.items()
                if key.endswith("_path") or key.endswith("_root")
            ]
            require(
                all(not (p == out or p in out.parents or out in p.parents) for p in inputs), code=7
            )
        except (Refused, OSError) as exc:
            raise Refused(7) from exc
        snapshot = {}
        for key, name in (
            ("catalog", "inputs/tool-catalog.json"),
            ("producer_receipt", "inputs/tool-producer-receipt.json"),
            ("producer_input", "inputs/tool-producer-input.json"),
            ("policy_input", "inputs/route-policy.json"),
            ("profile", "inputs/guidance-profile.json"),
            ("observation", "inputs/guidance-observation.json"),
            ("template", "templates/discovery.txt"),
            ("guidance_manifest", "guidance/manifest.json"),
        ):
            data = held.read(request[key + "_path"], mode=0o600)
            require(H(data) == request[key + "_sha256"])
            snapshot[name] = data
        require(
            snapshot["templates/discovery.txt"]
            == held.read(owning / "templates/discovery.txt", mode=0o644)
        )
        require(
            snapshot["guidance/manifest.json"]
            == held.read(owning / "guidance/manifest.json", mode=0o644)
        )
        for tool in TOOLS:
            snapshot["guidance/" + tool + ".json"] = held.read(
                owning / ("guidance/" + tool + ".json"), mode=0o644
            )
        snapshot["guidance/required-global-policy.json"] = held.read(
            owning / "guidance/required-global-policy.json", mode=0o644
        )
        for record in request["imported_files"]:
            data = held.read(
                Path(request["imported_output_root"]) / record["path"], mode=0o644, limit=65536
            )
            require(H(data) == record["sha256"])
            snapshot["baseline/" + record["path"]] = data
        snapshot["final-instructions/.config/agents/huyang.md"] = snapshot[
            "baseline/.config/agents/huyang.md"
        ]
        policy = decode(snapshot["inputs/route-policy.json"])
        require(H(snapshot["inputs/route-policy.json"]) == POLICY_PIN)
        models = {}
        for name in (
            ".config/agents/AGENTS.md",
            ".claude/omarchy-setup/CLAUDE.md",
            ".codex/AGENTS.md",
        ):
            original = snapshot["baseline/" + name].decode()
            last_role = "read" if name.startswith(".claude/") else "3d"
            match = re.search(
                r"## Model roles \([a-z]+\)\n[\s\S]*?\n- " + last_role + r": [^\n]*\n\n", original
            )
            require(match is not None)
            models[name] = match[0]
        snapshot["inputs/model-blocks.json"] = C(models)
        require(type(policy) is dict and len(source_pins) == 26)
        _, guidance, _ = _complete_projection(snapshot)
        held.check()
        # Frozen source owner handoff is absent. No public bypass can remove it.
        require(guidance["owner_handoff"] == "blocked-owner-handoff")
        raise Refused(8)


def _inventory(held, root):
    """Physical closed tree enumeration; all directories private, no extra files."""
    found = set()
    directories = set()
    root_fd = held.open(root, directory=True, mode=0o700)

    def walk(fd, prefix):
        for name in sorted(os.listdir(fd)):
            relative = prefix + name
            safe(relative)
            info = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISDIR(info.st_mode):
                child = held.open(Path(root) / relative, directory=True, mode=0o700)
                directories.add(relative)
                walk(child, relative + "/")
            else:
                require(stat.S_ISREG(info.st_mode) and info.st_nlink == 1)
                found.add(relative)

    walk(root_fd, "")
    return found, directories


def _stored(root, format_name, tool):
    require(format_name in ("json", "text") and tool in ("all", *TOOLS), code=3)
    with Held() as held:
        receipt = decode(held.read(Path(root) / "receipt.json", mode=0o600))
        validate(receipt, SCHEMAS["shared_receipt_v5"])
        require(all(receipt["source_sha256"][name] == pin for name, pin in SOURCE_PINS.items()))
        require(
            H(held.read(Path(__file__).absolute(), mode=0o755, limit=1048576))
            == receipt["source_sha256"]["shared/catalog-guidance/config/bin/agents-tool-project"]
        )
        expected = (
            set(CLOSURE["instruction_paths"])
            | {"skills/" + p for p in CLOSURE["skills_paths"]}
            | set(CLOSURE["new_input_paths"])
            | set(CLOSURE["new_metadata_paths"])
            | {
                "inputs/tool-catalog.json",
                "inputs/tool-producer-receipt.json",
                "inputs/tool-producer-input.json",
                "inputs/route-policy.json",
            }
        )
        records = receipt["files"]
        require([r["path"] for r in records] == sorted(expected))
        found, directories = _inventory(held, root)
        require(found == expected | {"receipt.json"})
        wanted_dirs = {str(p) for name in expected for p in Path(name).parents if str(p) != "."}
        require(directories == wanted_dirs)
        payload = {}
        for record in records:
            name = record["path"]
            correct_kind = (
                "instruction"
                if name in CLOSURE["instruction_paths"]
                else "skill"
                if name.startswith("skills/")
                else "guidance-input"
                if name in CLOSURE["new_input_paths"]
                else "guidance-metadata"
                if name in CLOSURE["new_metadata_paths"]
                else "policy-input"
                if name == "inputs/route-policy.json"
                else "producer-receipt"
                if name == "inputs/tool-producer-receipt.json"
                else "catalog-input"
            )
            require(record["kind"] == correct_kind and record["logical_destination"] == name)
            expected_mode = 0o600 if name.startswith("inputs/") else 0o644
            require(record["mode"] == expected_mode)
            data = held.read(Path(root) / name, mode=expected_mode, limit=262144)
            require(H(data) == record["sha256"])
            payload[name] = data
        guidance = receipt["guidance"]
        projection = guidance["projection"]
        require(H(C(projection)) == guidance["projection_sha256"])
        validate(projection, SCHEMAS["dual_guidance_summary_v1"])
        aliases = {
            "manifest": "tool-guidance-manifest",
            "profile": "guidance-profile",
            "observation": "guidance-observation",
            "global_policy": "required-global-policy",
            "layout": "guidance-layout",
        }
        for key, filename in aliases.items():
            require(H(payload["inputs/" + filename + ".json"]) == guidance[key + "_sha256"])
        manifest = decode(payload["inputs/tool-guidance-manifest.json"])
        validate(manifest, SCHEMAS["tool_guidance_manifest_v1"])
        require(manifest["records"] == guidance["packages"])
        require(
            manifest["catalog_sha256"]
            == receipt["catalog"]["catalog_sha256"]
            == H(payload["inputs/tool-catalog.json"])
            == projection["catalog_sha256"]
        )
        require(
            manifest["producer_receipt_sha256"]
            == receipt["catalog"]["producer_receipt_sha256"]
            == H(payload["inputs/tool-producer-receipt.json"])
            == projection["producer_receipt_sha256"]
        )
        require(
            manifest["policy_sha256"]
            == POLICY_PIN
            == H(payload["inputs/route-policy.json"])
            == receipt["policy"]["canonical_policy_sha256"]
            == projection["policy_sha256"]
        )
        require(receipt["catalog"]["tokenizer_manifest_sha256"] == TOKENIZER_PIN)
        require(
            guidance["manifest_sha256"] == projection["guidance_manifest_sha256"]
            and guidance["profile_sha256"] == projection["profile_sha256"]
            and guidance["global_policy_sha256"] == projection["required_global_policy_sha256"]
            and guidance["layout_sha256"] == projection["layout_sha256"]
        )
        profile = decode(payload["inputs/guidance-profile.json"])
        validate(profile, SCHEMAS["guidance_profile_v1"])
        require(
            profile["evidence"]
            == {
                "path": "inputs/guidance-observation.json",
                "sha256": guidance["observation_sha256"],
            }
        )
        observation = decode(payload["inputs/guidance-observation.json"])
        validate(observation, SCHEMAS["guidance_observation_v1"])
        observed = {
            f["path"]: H(f["content"].encode())
            for f in observation["source_reads"]["data"]["files"]
            + observation["descriptor_reads"]["data"]["files"]
        }
        require(
            len(observed) == 17
            and all(receipt["source_sha256"][p] == pin for p, pin in observed.items())
        )
        policy = decode(payload["inputs/required-global-policy.json"])
        validate(policy, SCHEMAS["required_global_policy_v1"])
        require(
            policy["deferred_owner_seam"]["status"]
            == projection["owner_handoff"]
            == "blocked-owner-handoff"
        )
        require(
            payload[".config/agents/operational-guidance.md"]
            == policy["operational_reference"].encode()
        )
        layout = decode(payload["inputs/guidance-layout.json"])
        validate(layout, SCHEMAS["layout_v4"])
        require(layout["bindings"]["guidance_manifest_sha256"] == guidance["manifest_sha256"])
        source_aliases = {
            "shared/catalog-guidance/templates/discovery.txt": "inputs/guidance-layout.json",
            "shared/catalog-guidance/guidance/manifest.json": "inputs/tool-guidance-manifest.json",
            "shared/catalog-guidance/guidance/required-global-policy.json": "inputs/required-global-policy.json",
            **{
                "shared/catalog-guidance/guidance/" + t + ".json": "inputs/tool-guidance/"
                + t
                + ".json"
                for t in TOOLS
            },
        }
        for source, name in source_aliases.items():
            require(receipt["source_sha256"][source] == H(payload[name]))
        # Owner5 is a closed immutable descriptor, not a retained executable.
        require(
            receipt["owner_descriptor_sha256"]
            == receipt["source_sha256"]["shared/catalog-guidance/owner.json"]
        )
        menu = decode(payload["metadata/guidance/menu.json"])
        validate(menu, SCHEMAS["guidance_menu_v1"])
        require(
            menu["catalog_sha256"] == manifest["catalog_sha256"]
            and menu["guidance_manifest_sha256"] == guidance["manifest_sha256"]
            and menu["profile_sha256"] == guidance["profile_sha256"]
            and menu["status"] == projection["status"]
        )
        catalog = decode(payload["inputs/tool-catalog.json"])
        validate(catalog, SCHEMAS["catalog_v1"])
        producer = decode(payload["inputs/tool-producer-receipt.json"])
        validate(producer, SCHEMAS["producer_receipt_v1"])
        require(
            producer["catalog_sha256"] == H(payload["inputs/tool-catalog.json"])
            and producer["input_sha256"] == H(payload["inputs/tool-producer-input.json"])
        )
        require(
            [r["tool_id"] for r in menu["tools"]] == list(TOOLS)
            and [r["tool_id"] for r in projection["decisions"]] == list(TOOLS)
        )
        decisions = {r["tool_id"]: r for r in projection["decisions"]}
        profiles = {r["tool_id"]: r for r in profile["tools"]}
        tools = {r["id"]: r for r in catalog["tools"]}
        for record, row in zip(manifest["records"], menu["tools"], strict=True):
            name = "inputs/tool-guidance/" + record["tool_id"] + ".json"
            package = decode(payload[name])
            validate(package, SCHEMAS["tool_guidance_v1"])
            require(H(payload[name]) == record["sha256"] == row["guidance_sha256"])
            require(
                package["tool_id"] == row["tool_id"]
                and row["catalog_record"] == tools[row["tool_id"]]
            )
            for key in ("purpose", "rules", "workflow", "help", "owner"):
                require(row[key] == package[key])
            for key in ("availability", "visibility", "authorized", "enforced"):
                require(row[key] == profiles[row["tool_id"]][key])
            owner = package["owner"]
            require(receipt["source_sha256"][owner["source_path"]] == owner["source_sha256"])
            require(package["capability_ids"] == row["catalog_record"]["capabilities"])
            descriptor = package["help"]
            if descriptor["kind"] == "pinned-reference":
                detail = payload[descriptor["path"]]
                require(H(detail) == descriptor["sha256"])
            else:
                require(
                    descriptor["path"] == "inputs/tool-catalog.json"
                    and descriptor["sha256"] == H(payload[descriptor["path"]])
                    and descriptor["tool_id"] == row["tool_id"]
                )
                detail = C(row["catalog_record"])
            require(row["detail"].encode() == detail)
            decision = decisions[row["tool_id"]]
            fragment = payload["metadata/guidance/fragments/" + row["tool_id"] + ".md"]
            require(
                H(fragment) == row["fragment_sha256"] == decision["fragment_sha256"]
                and H(detail) == decision["help_sha256"]
                and decision["source_owner"] == owner
                and decision["guidance_sha256"] == record["sha256"]
                and decision["rule_ids"] == [r["id"] for r in package["rules"]]
                and decision["decision"] == row["decision"]
            )
        for record in projection["files"]:
            name = record["path"]
            retained = (
                "metadata/guidance/" + name
                if name.startswith(("fragments/", "menu."))
                else name.removeprefix("final-instructions/")
            )
            if name == "discovery.txt":
                continue
            require(
                retained in payload
                and H(payload[retained]) == record["sha256"]
                and len(payload[retained]) == record["bytes"]
                and record["mode"] == 0o644
            )
        held.check()
        if format_name == "json":
            return C(
                {
                    "schema": "guidance-view/v1",
                    "schema_version": 1,
                    "menu": menu,
                    "selected_tool": tool,
                }
            )
        if tool == "all":
            return payload["metadata/guidance/menu.txt"]
        row = next(row for row in menu["tools"] if row["tool_id"] == tool)
        return row["detail"].encode()


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        require(len(argv) == 6, code=2)
        if argv[0] == "--request":
            require(argv[2] == "--request-sha256" and argv[4] == "--output-root", code=2)
            _runtime()
            _prepare((argv[1], argv[3], argv[5]))
        elif argv[0] == "--stored-generation":
            require(argv[2] == "--format" and argv[4] == "--tool", code=2)
            result = _stored(argv[1], argv[3], argv[5])
            require(len(result) <= 65536)
            sys.stdout.buffer.write(result)
        else:
            raise Refused(2)
        return 0
    except Refused as exc:
        sys.stderr.write(ERRORS[exc.code] + "\n")
        return exc.code
    except (OSError, ValueError, KeyError, TypeError, UnicodeError, RecursionError):
        sys.stderr.write(ERRORS[4] + "\n")
        return 4


if __name__ == "__main__":
    sys.exit(main())
